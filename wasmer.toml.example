# OPSIONAL - hanya jika deploy lewat CLI (wasmer deploy). Ganti nama jadi wasmer.toml
# Untuk deploy lewat "Import from Git" di wasmer.io, file ini TIDAK diperlukan.
[dependencies]
"php/php" = "=8.3.4"

[fs]
"/app/" = "."

[[command]]
name = "run"
module = "php/php:php"
runner = "wasi"
[command.annotations.wasi]
main-args = ["-t", "/app/public", "-S", "localhost:8080"]
